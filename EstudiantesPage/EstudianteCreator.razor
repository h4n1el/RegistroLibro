@using static Microsoft.AspNetCore.Components.Web.RenderMode

@page "/Estudiante/Create"
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer

@inject EstudianteServices EstudianteServices
@inject NavigationManager Navigation

<PageTitle>Registrar Estudiante</PageTitle>

<div class="container mt-4">

    <div class="card">

        @* Encabezado *@
        <div class="card-header text-center">
            <h3>Registrar Estudiante</h3>
        </div>

        @* Formulario *@
        <div class="card-body">

            
            </div>

            @* Nombre *@
            <div class="mb-3">
                <label class="form-label">
                    Nombre
                </label>
                <input type="text"
                       class="form-control"
                       @bind="Nombre" />
            </div>

            @* Direccion *@
            <div class="mb-3">
                <label class="form-label">
                    Direccion
                </label>
                <input type="text"
                       class="form-control"
                       @bind="Direccion" />
            </div>

            @* Email *@
            <div class="mb-3">
                <label class="form-label">
                    Email
                </label>
                <input type="text"
                       class="form-control"
                       @bind="Email" />
            </div>

            @* FechaNacimiento *@
            <div class="mb-3">
                <label class="form-label">
                    FechaNacimiento
                </label>
                <input type="number"
                       class="form-control"
                       @bind="FechaNacimiento" />
            </div>

            @* Mensaje *@
            @if (!string.IsNullOrEmpty(Mensaje))
            {
                <div class="alert alert-danger">
                    @Mensaje
                </div>
            }

        </div>

        @* Botones *@
        <div class="card-footer">

            <div class="d-flex justify-content-center gap-2">

                @* Cancelar *@
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="Cancelar">
                    Cancelar
                </button>

                @* Guardar *@
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="Guardar">
                    Guardar
                </button>

            </div>

        </div>

    </div>



@code 
{
    

    private string Nombre = "";

    private string Direccion = "";

    private string Email = "";

    private int FechaNacimiento;

    private string Mensaje = "";

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(Nombre))
        {
            Mensaje = "Dede de escribir un Nombre";
            return;
        }

        if (string.IsNullOrWhiteSpace(Direccion))
        {
            Mensaje = "debe tener una direccion";
            return;
        }

        if (string.IsNullOrWhiteSpace(Email))
        {
            Mensaje = "debe tener un correo";
            return;
        }

        if( FechaNacimiento <= 0)
        {
            Mensaje = "debe tener un año de nacimiento";
            return;
        }

        RegistroEstudiante.Models.Estudiantes estudiantes = new RegistroEstudiante.Models.Estudiantes()
        {
            
            Nombre = Nombre,
            Direccion = Direccion,
            Email = Email,
            FechaNacimiento = FechaNacimiento

        };

        bool resultado = await EstudianteServices.Guardar(estudiantes);

        if (resultado)
        {
            Navigation.NavigateTo("/Estudiante/Index");
        }
        else
        {
            Mensaje = "Error al guardar el estudiante";
        }

    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/Estudiante/Index");
        
    }



}




             
                      

