@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Components.Web

@page "/Estudiante/Edit/{EstudianteId:int}"


@rendermode InteractiveServer

@inject EstudianteServices EstudianteServices
@inject NavigationManager  Navigation 

<PageTitle>Editar Registro</PageTitle>

<div class="container mt-4">

    <div class="card">

        @* Titular *@
        <div class="card-header text-center">
            <h3>Editar Estudiante</h3>
        </div>

        @* Panel Formulario *@
        <div class="card-body">

            @* EstudianteId *@
            <div class="mb-3">
                <label class="form-label">
                    EstudianteId
                </label>

                <input type="text"
                       class="form-control"
                       @bind="estudiantes.EstudianteId"
                       disabled />
            </div>

            @* Nombre *@
            <div class="mb-3">
                <label class="form-label">
                    Nombre
                </label>

                <input type="text"
                       class="form-control"
                       @bind="estudiantes.Nombre" />
            </div>

            @* Direccion *@
            <div class="mb-3">
                <label class="form-label">
                    Direccion
                </label>

                <input type="text"
                       class="form-control"
                       @bind="estudiantes.Direccion" />
            </div>

            @* Email *@
            <div class="mb-3">
                <label class="form-label">
                    Email
                </label>

                <input type="text"
                       class="form-control"
                       @bind="estudiantes.Email" />
            </div>

            @* FechaNacimiento *@
            <div class="mb-3">
                <label class="form-label">
                    FechaNacimiento
                </label>

                <input type="text"
                       class="form-control"
                       @bind="estudiantes.FechaNacimiento" />
            </div>

            @* Mensaje *@
            @if (!string.IsNullOrWhiteSpace(Mensaje))
            {
                <div class="alert alert-danger">
                    @Mensaje
                </div>
            }

        </div>

        @* Botones *@
        <div class="card-footer">

            <div class="d-flex justify-content-center gap-2">

                @* Volver *@
                <button type="button"
                        class="btn btn-primary"
                        @onclick="Volver">
                    Volver
                </button>

                @* Modificar *@
                <button type="button"
                        class="btn btn-danger"
                        @onclick="Modificar">
                    Modificar
                </button>

                @* Eliminar *@
                <button type="button"
                        class="btn btn-danger"
                        @onclick="Eliminar">
                    Eliminar
                </button>

            </div>

        </div>

    </div>

</div>

@code
{
    [Parameter]
    public int EstudianteId {get; set;}

    public string? Mensaje = "";

    private RegistroEstudiante.Models.Estudiantes estudiantes =  new RegistroEstudiante.Models.Estudiantes();

    protected override async Task OnInitializedAsync()
    {
        RegistroEstudiante.Models.Estudiantes? resultado = await EstudianteServices.Buscar(EstudianteId);

        if(resultado != null)
        {
            estudiantes = resultado;
        } else
        {
            Mensaje = "No se encontro el estudiante";
        }
    }

    private async Task Modificar()
    {
        if (string.IsNullOrWhiteSpace(estudiantes.Nombre))
        {
            Mensaje = "El nombre debe ser obligatorio";
            return;
        }

        if (string.IsNullOrWhiteSpace(estudiantes.Direccion))
        {
            Mensaje = "La direccion es obligatoria";
            return;
        }

        if (string.IsNullOrWhiteSpace(estudiantes.Email))
        {
            Mensaje = "El Email es obligatorio";
            return;
        }

        if(estudiantes.FechaNacimiento <= 0)
        {
            Mensaje = "la fecha de nacimiento es obligatoria";
            return;
        }

        bool resultado = await EstudianteServices.Modificar(estudiantes);

        if (resultado)
        {
            Navigation.NavigateTo("/Estudiante/Index");
        } else
        {
            Mensaje = "error al modificar el estudiante";
        }


    }
    private async Task Eliminar()
    {
        bool resultado = await EstudianteServices.Eliminar(EstudianteId);

        if (resultado)
        {
            Navigation.NavigateTo("/Estudiante");
        } else
        {
            Mensaje = "error al eliminar el estudiante";
        }
    }
    private void Volver()
    {
        Navigation.NavigateTo("/Estudiantes");
    }
}