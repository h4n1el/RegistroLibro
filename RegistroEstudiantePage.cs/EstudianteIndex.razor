@using RegistroLibros.Services
@using RegistroLibros.DAL
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Components.Web

@page "/Estudiante/Index"
@inject EstudianteServices estudianteServices
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>Estudiantes</PageTitle>

<h3>Listado de Estudiantes</h3>

<a href="/estudiante/create" class="btn btn-primary mb-3">Registrar Estudiante</a>

@if (estudiantes == null)
{
    <p><em>Cargando...</em></p>
}
else if (!estudiantes.Any())
{
    <p>No hay estudiantes registrados.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>EstudianteId</th>
                <th>Nombres</th>
                <th>Dirección</th>
                <th>Email</th>
                <th>Fecha de Nacimiento</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var estudiante in estudiantes)
            {
                <tr>
                    <td>@estudiante.EstudianteId</td>
                    <td>@estudiante.Nombres</td>
                    <td>@estudiante.Direccion</td>
                    <td>@estudiante.Email</td>
                    <td>@estudiante.FechaNacimiento.ToShortDateString()</td>
                    <td>
                        <a href="@($"/estudiante/edit/{estudiante.EstudianteId}")" class="btn btn-warning btn-sm">Editar</a>
                        <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(estudiante.EstudianteId)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p><strong>Cantidad: @estudiantes.Count()</strong></p>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <p class="text-success mt-2">@mensaje</p>
    }
}

@code {
    private List<Estudiante>? estudiantes;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        await CargarEstudiantes();
    }

    private async Task CargarEstudiantes()
    {
        estudiantes = await estudianteServices.ObtenerTodosAsync();
    }

    private async Task ConfirmarEliminar(int id)
    {
        await estudianteServices.EliminarAsync(id);
        mensaje = "Estudiante ha sido eliminado.";
        await CargarEstudiantes();
    }
}
