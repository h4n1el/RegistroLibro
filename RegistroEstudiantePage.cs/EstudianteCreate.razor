@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using RegistroLibros.Services

@page "/estudiante/create"
@inject EstudianteServices estudianteServices
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>Registrar Estudiante</PageTitle>

<h3>Registrar Estudiante</h3>

<EditForm Model="estudiante" OnValidSubmit="Guardar" FormName="GuardarEstudiante">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Nombres</label>
        <InputText class="form-control" @bind-Value="estudiante.Nombres" />
    </div>

    <div class="mb-3">
        <label class="form-label">Dirección</label>
        <InputText class="form-control" @bind-Value="estudiante.Direccion" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="estudiante.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha de Nacimiento</label>
        <InputDate class="form-control" @bind-Value="estudiante.FechaNacimiento" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <p class="text-danger mt-2">@mensaje</p>
    }
</EditForm>

@code {
    private Estudiante estudiante = new();
    private string? mensaje;

    private async Task Guardar()
    {
        var (exito, error) = await estudianteServices.Guardar(estudiante);

        if (exito)
        {
            navigationManager.NavigateTo("/Estudiante/Index");
        }
        else
        {
            mensaje = error;
        }
    }

    private void Cancelar()
    {
        navigationManager.NavigateTo("/Estudiante/Index");
    }
}
